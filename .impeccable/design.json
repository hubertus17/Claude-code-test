    },
    {
      "name": "Shipping Slip",
      "kind": "custom",
      "refersTo": "slip",
      "description": "Signature: one order part as a label with mono part tag, sender, perforation with notches, items and an invoice footer.",
      "html": "<div class=\"ds-slip\"><div class=\"ds-slip-h\"><span class=\"ds-n l\"></span><span class=\"ds-n r\"></span><span class=\"ds-tag\">CZĘŚĆ 1/2</span><div class=\"ds-sender\"><b><i></i>Spółka A</b><small>Wysyłka z magazynu — · jutro</small></div></div><div class=\"ds-it\"><span>Dieta weterynaryjna, 2 kg</span><b>118,00 zł</b></div><div class=\"ds-slip-f\"><span>Fakturę wystawi Spółka A · osobna paczka</span><span>Razem <b>140,00 zł</b></span></div></div>",
      "css": ".ds-slip{font-family:Archivo,system-ui,sans-serif;width:520px;background:#fff;border:1px solid #cbd4de;color:#14181d;font-size:15px}.ds-slip-h{display:flex;align-items:center;gap:16px;min-height:56px;padding:10px 20px;position:relative}.ds-slip-h:after{content:\"\";position:absolute;left:14px;right:14px;bottom:-1px;border-bottom:1.5px dashed #cbd4de}.ds-n{position:absolute;bottom:-8px;width:16px;height:16px;border-radius:50%;background:#e6ecf2;border:1px solid #cbd4de;z-index:1}.ds-n.l{left:-9px;clip-path:inset(0 0 0 50%)}.ds-n.r{right:-9px;clip-path:inset(0 50% 0 0)}.ds-tag{display:inline-flex;align-items:center;height:24px;padding:0 8px;background:#14181d;color:#fff;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11.5px;font-weight:600;letter-spacing:.04em}.ds-sender{display:flex;flex-direction:column;line-height:1.25}.ds-sender b{font-size:16px;font-weight:600;display:flex;align-items:center;gap:8px}.ds-sender b i{width:10px;height:10px;background:#0f6e74}.ds-sender small{font-size:12.5px;color:#5b6673;margin-top:2px}.ds-it{display:flex;justify-content:space-between;padding:16px 20px;font-variant-numeric:tabular-nums}.ds-slip-f{display:flex;justify-content:space-between;padding:12px 20px;background:#f4f7fa;border-top:1px solid #e3e8ee;font-size:14px}"
    },
    {
