  "narrative": {
    "northStar": "The Consolidated Waybill",
    "overview": "An order is a consolidated letter made of shipping slips: white label stock with a hairline frame, a perforation under each label head, notches, a black mono part tag and a barcode, carried by a navy shell on a cool sorting-table ground. The system is dense and operational at 1440px, with tabular figures and no hero scale. Navy carries brand and structure, signal orange marks only the money-moving action and states that need action, and three seller colours appear only as small swatches.",
    "keyCharacteristics": [
      "Square white documents on a cool ground; 6px rounding for controls only.",
      "Perforation and notches mark where a document divides.",
      "JetBrains Mono for codes and IDs; Archivo for everything else.",
      "One signal colour; three seller swatches as identity markers.",
      "Flat: borders, washes and the navy shell instead of shadows."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Signal orange marks the single money-moving action on a screen and states that require someone to act.",
        "section": "colors"
      },
      {
        "name": "The Swatch-Only Rule",
        "body": "Seller colours appear as small squares, chart series or pack bands, never as text, fills behind text or buttons.",
        "section": "colors"
      },
      {
        "name": "The Label-Print Rule",
        "body": "Mono is for machine-printed things: codes, part numbers, order and document IDs.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number in tables, bills, figures and prices uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Divider-Not-Gap Rule",
        "body": "Items inside a document are split by 1px rules; documents are split by ground.",
        "section": "layout"
      },
      {
        "name": "The Paper-on-Table Rule",
        "body": "Documents lie flat on the ground; they never float.",
        "section": "elevation"
      },
      {
        "name": "The Torn-Here Rule",
        "body": "A dashed rule means the document divides here; never decoration.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do show every order part as its own slip with tag, sender, warehouse and footer where documents, shipments or refunds are explained.",
      "Do keep documents square and controls at 6px.",
      "Do put codes, part numbers and document IDs in JetBrains Mono, and every number in tabular figures.",
      "Do separate rows inside a document with hairlines and documents with 20px of ground.",
      "Do reserve signal orange for the money-moving action and states someone must act on.",
      "Do use the self-hosted Archivo and JetBrains Mono and the supplied [Marka] logotype."
