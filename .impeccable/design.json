      "kind": "card",
      "refersTo": "summary-bill",
      "description": "Consolidated summary: navy top rule, per-seller rows, dashed rule, navy total.",
      "html": "<div class=\"ds-bill\"><h3>Podsumowanie</h3><div class=\"ds-row\"><span><i style=\"background:#0f6e74\"></i>Spółka A</span><span>140,00 zł</span></div><div class=\"ds-row\"><span><i style=\"background:#a8640f\"></i>Marka własna grupy</span><span>101,00 zł</span></div><div class=\"ds-dash\"></div><div class=\"ds-row\"><b>Do zapłaty</b><span class=\"ds-total\">255,99 zł</span></div></div>",
      "css": ".ds-bill{font-family:Archivo,system-ui,sans-serif;width:360px;background:#fff;border:1px solid #cbd4de;border-top:4px solid #123a63;padding:18px 22px;color:#14181d}.ds-bill h3{font-size:18px;font-weight:700;letter-spacing:-.01em;margin:0 0 8px}.ds-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;font-variant-numeric:tabular-nums}.ds-row span{display:inline-flex;align-items:center;gap:8px}.ds-row i{width:10px;height:10px;display:inline-block}.ds-dash{border-top:1.5px dashed #cbd4de;margin:10px 0}.ds-total{font-size:24px;font-weight:800;color:#123a63;letter-spacing:-.01em}"
