      "css": ".ds-input{font-family:Archivo,system-ui,sans-serif;display:flex;align-items:center;gap:10px;height:42px;width:280px;border:1px solid #cbd4de;border-radius:6px;background:#fff;padding:0 12px;color:#5b6673;font-size:14px}.ds-input input{border:0;outline:0;font:inherit;color:#14181d;flex:1;background:none}.ds-input input::placeholder{color:#5b6673}.ds-input:focus-within{outline:2px solid #c2410c;outline-offset:2px}"
